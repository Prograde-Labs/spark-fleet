# Spark Fleet environment template.
# Copy to .env on the controller/agent host and keep it out of Git.

# Required on both controller and agent; use the same value fleet-wide.
SPARK_FLEET_AGENT_TOKEN=replace-with-at-least-16-url-safe-characters

# Optional UI login (both values must be set together to enable login).
# SPARK_FLEET_UI_PASSWORD=replace-with-a-strong-password
# SPARK_FLEET_SESSION_SECRET=replace-with-at-least-32-random-characters

# Controller ---------------------------------------------------------------
SPARK_FLEET_CONTROLLER_HOST=0.0.0.0
SPARK_FLEET_CONTROLLER_PORT=8091
SPARK_FLEET_DATA_DIR=/var/lib/spark-fleet
SPARK_FLEET_RECIPES_DIR=/var/lib/spark-fleet/recipes
SPARK_FLEET_ROLLBACK_POLICY=restore
SPARK_FLEET_METRICS_RETENTION_SECONDS=86400
SPARK_FLEET_METRICS_SAMPLE_INTERVAL_SECONDS=10
SPARK_FLEET_NODE_POLL_INTERVAL_SECONDS=15
SPARK_FLEET_LOG_LEVEL=INFO

# Agent --------------------------------------------------------------------
SPARK_FLEET_AGENT_HOST=0.0.0.0
SPARK_FLEET_AGENT_PORT=8092
SPARK_FLEET_AGENT_NODE_ID=spark-01
SPARK_FLEET_AGENT_DATA_DIR=/var/lib/spark-fleet-agent
SPARK_FLEET_MODEL_CACHE_ROOTS=/srv/spark-fleet/hub
SPARK_FLEET_MODEL_CACHE_ROOT=/srv/spark-fleet/hub
